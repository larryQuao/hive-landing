# Copy this file to `.env` for local development, and add the same variables
# in the hosting settings (Vercel) for the live site.

# Contact form (api/contact.ts): saves each message to the team's Google Sheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-google-spreadsheet-id

# The site's own public address, e.g. https://hiveagency.example (no trailing
# slash). Used for link previews (WhatsApp, LinkedIn…), the sitemap and search.
VITE_SITE_URL=
